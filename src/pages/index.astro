---
import { getCollection } from "astro:content";

const stories = await getCollection("stories");

const latestStories = stories
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const navItems = [
  { label: "Beranda", href: "#beranda" },
  { label: "Cerita", href: "/cerita/" },
  { label: "Galeri", href: "#galeri" },
  { label: "Tentang", href: "#tentang" },
];

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat("id-ID", {
    day: "numeric",
    month: "long",
    year: "numeric",
  }).format(date);
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Kopi & Kayuhan — cerita tentang kopi, perjalanan sepeda, dan momen sederhana dalam kehidupan." />
    <meta name="theme-color" content="#f8f7f3" />
    <title>Kopi & Kayuhan — Cerita dari Perjalanan</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet" />
  </head>

  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="#beranda">
          <span class="brand-icon">K&K</span>
          <span class="brand-name">Kopi & Kayuhan</span>
        </a>

        <nav aria-label="Navigasi utama">
          {navItems.map((item) => (
            <a href={item.href}>{item.label}</a>
          ))}
        </nav>
      </div>
    </header>

    <main>
      <section class="hero container" id="beranda">
        <div class="hero-content">
          <span class="eyebrow">SEBUAH CATATAN PERJALANAN</span>
          <h1>Menikmati hidup, satu perjalanan pada satu waktu.</h1>
          <p>
            Tentang secangkir kopi, kayuhan sepeda, tempat-tempat baru,
            dan cerita sederhana yang layak dikenang.
          </p>
          <a class="primary-button" href="#cerita">
            Jelajahi cerita <span aria-hidden="true">→</span>
          </a>
        </div>

        <div class="hero-image">
          <img
            src="https://images.unsplash.com/photo-1471506480208-91b3a4cc78be?w=1200&q=90"
            alt="Suasana perjalanan bersepeda"
          />
          <span class="image-caption">Perjalanan kecil, cerita yang berarti.</span>
        </div>
      </section>

      <section class="stories-section" id="cerita">
        <div class="container">
          <div class="section-heading">
            <div>
              <span class="eyebrow">DARI CATATAN HARIAN</span>
              <h2>Cerita terbaru</h2>
            </div>
            <a class="text-link" href="/cerita/">
				Lihat semua cerita →
			</a>
          </div>

          
		<div class="article-grid">
		{latestStories.map((story) => (
			<article class="article-card">
			<a
				class="article-image"
				href={`/cerita/${story.id}/`}
			>
				<img
				src={story.data.cover}
				alt={story.data.title}
				loading="lazy"
				/>
			</a>

			<div class="article-content">
				<span class="article-category">
				{story.data.category}
				</span>

				<h3>
				<a href={`/cerita/${story.id}/`}>
					{story.data.title}
				</a>
				</h3>

				<p>{story.data.description}</p>

				<time datetime={story.data.date.toISOString()}>
				{formatDate(story.data.date)}
				</time>
			</div>
			</article>
		))}
		</div>

        </div>
      </section>

      <section class="quote-section">
        <div class="container quote-inner">
          <span class="quote-mark">“</span>
          <blockquote>
            Tidak semua perjalanan harus jauh.
            Kadang, kebahagiaan ditemukan dari hal-hal sederhana.
          </blockquote>
          <span class="quote-credit">— Kopi & Kayuhan</span>
        </div>
      </section>

      <section class="about-section container" id="tentang">
        <div class="about-image">
          <img
            src="https://images.unsplash.com/photo-1500530855697-b586d89ba3ee?w=1000&q=85"
            alt="Pemandangan alam dalam sebuah perjalanan"
            loading="lazy"
          />
        </div>
        <div class="about-content">
          <span class="eyebrow">SEDIKIT TENTANG KAMI</span>
          <h2>Tempat menyimpan cerita dan kenangan.</h2>
          <p>
            Kopi & Kayuhan adalah ruang pribadi untuk berbagi pengalaman,
            mendokumentasikan perjalanan, dan mengabadikan momen-momen
            sederhana dalam kehidupan.
          </p>
          <a class="text-link" href="#tentang">Kenali lebih dekat →</a>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <a class="brand" href="#beranda">
          <span class="brand-icon">K&K</span>
          <span class="brand-name">Kopi & Kayuhan</span>
        </a>
        <p>Secangkir kopi, sejuta cerita.</p>
        <span class="copyright">
          © {new Date().getFullYear()} Kopi & Kayuhan.
        </span>
      </div>
    </footer>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    background: #f8f7f3;
    color: #292c25;
    font-family: "DM Sans", sans-serif;
    -webkit-font-smoothing: antialiased;
  }

  :global(a) {
    color: inherit;
    text-decoration: none;
  }

  .container {
    width: min(1120px, calc(100% - 48px));
    margin-inline: auto;
  }

  .site-header {
    background: #f8f7f3;
    border-bottom: 1px solid #e9e6dc;
  }

  .header-inner {
    min-height: 82px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    white-space: nowrap;
  }

  .brand-icon {
    width: 38px;
    height: 38px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: #59634a;
    color: white;
    font-family: "Playfair Display", serif;
    font-size: 13px;
    font-weight: 700;
  }

  .brand-name {
    font-family: "Playfair Display", serif;
    font-size: 19px;
    font-weight: 700;
  }

  nav {
    display: flex;
    align-items: center;
    gap: 34px;
  }

  nav a {
    color: #686a60;
    font-size: 14px;
    transition: color 0.2s;
  }

  nav a:hover,
  .text-link:hover {
    color: #59634a;
  }

  .hero {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    align-items: center;
    gap: 64px;
    padding-block: 76px 90px;
  }

  .eyebrow {
    color: #7a8069;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
  }

  h1,
  h2,
  blockquote {
    font-family: "Playfair Display", serif;
  }

  h1 {
    max-width: 500px;
    margin: 20px 0;
    font-size: clamp(38px, 5vw, 59px);
    font-weight: 600;
    line-height: 1.16;
    letter-spacing: -1.5px;
  }

  .hero-content > p {
    max-width: 430px;
    color: #74756c;
    font-size: 15px;
    line-height: 1.9;
  }

  .primary-button {
    display: inline-flex;
    align-items: center;
    gap: 15px;
    margin-top: 20px;
    padding: 14px 20px;
    border-radius: 4px;
    background: #59634a;
    color: white;
    font-size: 13px;
    font-weight: 600;
    transition: background 0.2s;
  }

  .primary-button:hover {
    background: #414b35;
  }

  .hero-image {
    position: relative;
    height: 420px;
  }

  .hero-image img,
  .article-image img,
  .about-image img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .hero-image img {
    border-radius: 3px;
  }

  .image-caption {
    position: absolute;
    right: 15px;
    bottom: 15px;
    padding: 9px 13px;
    background: rgba(255, 255, 255, 0.92);
    color: #55574e;
    font-size: 11px;
  }

  .stories-section {
    padding-block: 78px 90px;
    background: #f0efe8;
  }

  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 35px;
  }

  h2 {
    margin: 9px 0 0;
    font-size: 37px;
    font-weight: 600;
    letter-spacing: -0.5px;
  }

  .text-link {
    color: #59634a;
    font-size: 13px;
    font-weight: 600;
  }

  .article-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 25px;
  }

  .article-card {
    min-width: 0;
    background: #f8f7f3;
    border: 1px solid #e8e5db;
  }

  .article-image {
    display: block;
    height: 215px;
    overflow: hidden;
  }

  .article-image img {
    transition: transform 0.35s;
  }

  .article-card:hover .article-image img {
    transform: scale(1.04);
  }

  .article-content {
    padding: 22px 21px 24px;
  }

  .article-category {
    color: #7a8069;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.2px;
    text-transform: uppercase;
  }

  h3 {
    margin: 12px 0 9px;
    font-family: "Playfair Display", serif;
    font-size: 21px;
    line-height: 1.35;
  }

  .article-content p {
    min-height: 72px;
    margin: 0 0 18px;
    color: #77786f;
    font-size: 13px;
    line-height: 1.75;
  }

  .article-content time {
    color: #929187;
    font-size: 11px;
  }

  .quote-section {
    padding-block: 80px;
    background: #59634a;
    color: #fff;
    text-align: center;
  }

  .quote-inner {
    max-width: 720px;
  }

  .quote-mark {
    color: #c9cfbb;
    font-family: "Playfair Display", serif;
    font-size: 65px;
    line-height: 0.8;
  }

  blockquote {
    margin: 20px 0;
    font-size: clamp(25px, 4vw, 36px);
    line-height: 1.5;
  }

  .quote-credit {
    color: #d4d8cb;
    font-size: 12px;
  }

  .about-section {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 65px;
    padding-block: 90px;
  }

  .about-image {
    height: 350px;
  }

  .about-image img {
    border-radius: 3px;
  }

  .about-content h2 {
    max-width: 440px;
    margin-block: 15px;
    line-height: 1.25;
  }

  .about-content p {
    max-width: 440px;
    margin-bottom: 25px;
    color: #74756c;
    font-size: 14px;
    line-height: 1.9;
  }

  .site-footer {
    border-top: 1px solid #e9e6dc;
  }

  .footer-inner {
    min-height: 100px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  .footer-inner p,
  .copyright {
    color: #85857c;
    font-size: 12px;
  }

  @media (max-width: 760px) {
    .container {
      width: min(100% - 36px, 560px);
    }

    .header-inner {
      min-height: auto;
      padding-block: 17px;
      align-items: flex-start;
      flex-direction: column;
      gap: 17px;
    }

    nav {
      width: 100%;
      justify-content: space-between;
      gap: 12px;
    }

    nav a {
      font-size: 12px;
    }

    .hero {
      grid-template-columns: 1fr;
      gap: 32px;
      padding-block: 55px 65px;
    }

    h1 {
      font-size: 43px;
    }

    .hero-image {
      height: 290px;
    }

    .stories-section {
      padding-block: 60px;
    }

    .section-heading {
      align-items: flex-start;
      flex-direction: column;
    }

    h2 {
      font-size: 32px;
    }

    .article-grid {
      grid-template-columns: 1fr;
      gap: 22px;
    }

    .article-image {
      height: 230px;
    }

    .article-content p {
      min-height: 0;
    }

    .quote-section {
      padding-block: 65px;
    }

    .about-section {
      grid-template-columns: 1fr;
      gap: 30px;
      padding-block: 65px;
    }

    .about-image {
      height: 260px;
    }

    .footer-inner {
      align-items: flex-start;
      flex-direction: column;
      justify-content: center;
      padding-block: 25px;
      gap: 10px;
    }
  }
</style>
